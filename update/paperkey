#!/bin/bash
set -e

# --- Configuration & Constants ---
MAGIC_MARK="pK"         # 2 Bytes ASCII
VERSION="06"            # 1 Byte Hex (Version VI)
DEFAULT_KEY_SIZE=128    # Default key size in bytes
OUTPUT_KEY="file.key"
OUTPUT_TXT="file.txt"
OUTPUT_PNG="file.key.png"

# ------------------------------------------------------------------
# Helper Functions: Native Base32 (Strip / Pad '=')
# ------------------------------------------------------------------
encode_b32_unpadded() {
    # Encode binary to base32, remove newlines and trailing '='
    base32 "$1" | tr -d '\n\r='
}

decode_b32_unpadded() {
    local b32_in="$1"
    local mod=$((${#b32_in} % 8))
    
    # Restore standard RFC 4648 Base32 padding if missing
    if [ $mod -ne 0 ]; then
        local pad_len=$((8 - mod))
        local pad=$(printf '=%.0s' $(seq 1 $pad_len))
        b32_in="${b32_in}${pad}"
    fi

    echo "$b32_in" | base32 -d
}

# ------------------------------------------------------------------
# 1. Generate Key, Pack Payload, Encrypt & Create QR Code
# ------------------------------------------------------------------
encrypt_key() {
    KEY_SIZE_DEC="${2:-$DEFAULT_KEY_SIZE}"

    if ! [[ "$KEY_SIZE_DEC" =~ ^[0-9]+$ ]] || [ "$KEY_SIZE_DEC" -le 0 ]; then
        echo "[-] Error: Invalid key size '$KEY_SIZE_DEC'. Must be a positive integer."
        exit 1
    fi

    read -sp "Enter Master Passphrase: " PASSPHRASE
    echo ""

    echo "[+] Generating $KEY_SIZE_DEC-byte raw random key..."
    openssl rand "$KEY_SIZE_DEC" > "$OUTPUT_KEY"

    TIMESTAMP=$(date +%s)
    DATE_FORMATTED=$(date "+%Y-%m-%d %H:%M:%S %Z")

    echo "[+] Calculating SHA-256 Checksum (First 4 Bytes)..."
    KEY_HASH_4B=$(openssl dgst -sha256 -binary "$OUTPUT_KEY" | head -c 4)

    echo "[+] Packing binary payload (Magic[2B] + Version[1B] + Epoch[4B] + KeySize[2B] + Key + Checksum[4B])..."
    PAYLOAD_FILE=$(mktemp)
    
    # 1. Magic Mark "pK" (2B)
    echo -n "$MAGIC_MARK" > "$PAYLOAD_FILE"
    
    # 2. Version (1B Hex -> 0x34 = 52 Dec)
    printf "$(echo -n "$VERSION" | sed 's/..\?/\\x&/g')" >> "$PAYLOAD_FILE"
    
    # 3. Fixed Binary Timestamp (4B Hex)
    TS_HEX=$(printf "%08x" "$TIMESTAMP")
    printf "$(echo -n "$TS_HEX" | sed 's/..\?/\\x&/g')" >> "$PAYLOAD_FILE"
    
    # 4. Key Size (2B Hex)
    KEY_LEN_HEX=$(printf "%04x" "$KEY_SIZE_DEC")
    printf "$(echo -n "$KEY_LEN_HEX" | sed 's/..\?/\\x&/g')" >> "$PAYLOAD_FILE"
    
    # 5. Key Bytes
    cat "$OUTPUT_KEY" >> "$PAYLOAD_FILE"
    
    # 6. Checksum (First 4B of SHA256)
    echo -n "$KEY_HASH_4B" >> "$PAYLOAD_FILE"

    echo "[+] Generating 16-byte Salt and 16-byte IV..."
    SALT_HEX=$(openssl rand -hex 16)
    IV_HEX=$(openssl rand -hex 16)

    echo "[+] Deriving 64-byte key (Encryption + HMAC) via Argon2id..."
    DERIVED_HEX=$(echo -n "$PASSPHRASE" | argon2 "$SALT_HEX" -id -t 3 -m 16 -p 4 -l 64 -r | tr -d '\n')
    AES_KEY_HEX="${DERIVED_HEX:0:64}"
    HMAC_KEY_HEX="${DERIVED_HEX:64:64}"

    echo "[+] Encrypting payload with AES-256-CBC..."
    CIPHERTEXT_FILE=$(mktemp)
    
    openssl enc -aes-256-cbc -e \
        -in "$PAYLOAD_FILE" \
        -out "$CIPHERTEXT_FILE" \
        -K "$AES_KEY_HEX" \
        -iv "$IV_HEX"

    echo "[+] Calculating HMAC-SHA256 for container integrity..."
    HMAC_FILE=$(mktemp)
    RAW_DATA_TO_MAC=$(mktemp)
    echo -n "$SALT_HEX$IV_HEX" | xxd -r -p > "$RAW_DATA_TO_MAC"
    cat "$CIPHERTEXT_FILE" >> "$RAW_DATA_TO_MAC"
    
    openssl dgst -sha256 -mac HMAC -macopt hexkey:"$HMAC_KEY_HEX" -binary "$RAW_DATA_TO_MAC" > "$HMAC_FILE"

    # Final Binary Package: Salt (16B) + IV (16B) + HMAC (32B) + Ciphertext
    FINAL_PAYLOAD=$(mktemp)
    echo -n "$SALT_HEX$IV_HEX" | xxd -r -p > "$FINAL_PAYLOAD"
    cat "$HMAC_FILE" >> "$FINAL_PAYLOAD"
    cat "$CIPHERTEXT_FILE" >> "$FINAL_PAYLOAD"

    echo "[+] Encoding final payload to Base32 (Unpadded)..."
    B32_DATA=$(encode_b32_unpadded "$FINAL_PAYLOAD")
    echo "$B32_DATA" > "$OUTPUT_TXT"

    echo "[+] Generating QR code image ($OUTPUT_PNG)..."
    qrencode -o "$OUTPUT_PNG" -s 10 -l M "$B32_DATA"

    # Cleanup
    rm -f "$PAYLOAD_FILE" "$CIPHERTEXT_FILE" "$HMAC_FILE" "$RAW_DATA_TO_MAC" "$FINAL_PAYLOAD"

    echo -e "\n[✔] Generation & Encryption Completed Successfully!"
    echo "========================================"
    echo "Payload Version    : $((16#$VERSION))"
    echo "Creation Date      : $DATE_FORMATTED"
    echo "Raw Key Saved To   : $OUTPUT_KEY ($KEY_SIZE_DEC Bytes)"
    echo "Base32 Text Output : $OUTPUT_TXT"
    echo "QR Code Output     : $OUTPUT_PNG"
    echo "========================================"
    echo ""
}

# ------------------------------------------------------------------
# 2. Decrypt Base32, Unpack Payload & Restore file.key
# ------------------------------------------------------------------
decrypt_key() {
    INPUT_FILE="${2:-$OUTPUT_TXT}"

    if [ ! -f "$INPUT_FILE" ]; then
        echo "[-] Error: Input file '$INPUT_FILE' not found!"
        exit 1
    fi

    read -sp "Enter Master Passphrase: " PASSPHRASE
    echo ""

    echo "[+] Reading Base32 data from $INPUT_FILE..."
    B32_IN=$(tr -d ' \n\r' < "$INPUT_FILE")
    
    echo "[+] Decoding Base32 to Binary payload..."
    DECRYPTED_RAW=$(mktemp)
    decode_b32_unpadded "$B32_IN" > "$DECRYPTED_RAW"

    # Extract Salt (16B), IV (16B), HMAC (32B)
    SALT_HEX=$(head -c 16 "$DECRYPTED_RAW" | xxd -p -c 256)
    IV_HEX=$(tail -c +17 "$DECRYPTED_RAW" | head -c 16 | xxd -p -c 256)
    EXPECTED_HMAC_HEX=$(tail -c +33 "$DECRYPTED_RAW" | head -c 32 | xxd -p -c 256)

    # Extract Ciphertext
    CIPHERTEXT_FILE=$(mktemp)
    tail -c +65 "$DECRYPTED_RAW" > "$CIPHERTEXT_FILE"

    echo "[+] Re-deriving keys via Argon2id..."
    DERIVED_HEX=$(echo -n "$PASSPHRASE" | argon2 "$SALT_HEX" -id -t 3 -m 16 -p 4 -l 64 -r | tr -d '\n')
    AES_KEY_HEX="${DERIVED_HEX:0:64}"
    HMAC_KEY_HEX="${DERIVED_HEX:64:64}"

    echo "[+] Verifying HMAC-SHA256 container integrity..."
    RAW_DATA_TO_MAC=$(mktemp)
    echo -n "$SALT_HEX$IV_HEX" | xxd -r -p > "$RAW_DATA_TO_MAC"
    cat "$CIPHERTEXT_FILE" >> "$RAW_DATA_TO_MAC"

    CALCULATED_HMAC_HEX=$(openssl dgst -sha256 -mac HMAC -macopt hexkey:"$HMAC_KEY_HEX" -r "$RAW_DATA_TO_MAC" | awk '{print $1}')

    if [ "$EXPECTED_HMAC_HEX" != "$CALCULATED_HMAC_HEX" ]; then
        echo "[-] Error: Container integrity check failed! Invalid passphrase or corrupted data."
        rm -f "$DECRYPTED_RAW" "$CIPHERTEXT_FILE" "$RAW_DATA_TO_MAC"
        exit 1
    fi

    echo "[+] Decrypting payload..."
    RESTORED_PAYLOAD=$(mktemp)

    if ! openssl enc -aes-256-cbc -d \
        -in "$CIPHERTEXT_FILE" \
        -out "$RESTORED_PAYLOAD" \
        -K "$AES_KEY_HEX" \
        -iv "$IV_HEX" 2>/dev/null; then
        echo "[-] Error: Decryption failed!"
        rm -f "$DECRYPTED_RAW" "$CIPHERTEXT_FILE" "$RAW_DATA_TO_MAC" "$RESTORED_PAYLOAD"
        exit 1
    fi

    echo "[+] Parsing structured binary payload..."
    
    # 1. Check Magic Mark "pK" (2 Bytes)
    MAGIC_EXTRACTED=$(head -c 2 "$RESTORED_PAYLOAD")
    if [ "$MAGIC_EXTRACTED" != "$MAGIC_MARK" ]; then
        echo "[-] Error: Invalid Magic Mark '$MAGIC_EXTRACTED' (Expected: '$MAGIC_MARK')!"
        rm -f "$DECRYPTED_RAW" "$CIPHERTEXT_FILE" "$RAW_DATA_TO_MAC" "$RESTORED_PAYLOAD"
        exit 1
    fi

    # 2. Version (1 Byte Hex at offset 3)
    VERSION_EXTRACTED=$(tail -c +3 "$RESTORED_PAYLOAD" | head -c 1 | xxd -p)
    VERSION_DEC=$((16#$VERSION_EXTRACTED))

    # 3. Binary Epoch Timestamp (4 Bytes Hex at offset 4)
    TS_HEX_EXTRACTED=$(tail -c +4 "$RESTORED_PAYLOAD" | head -c 4 | xxd -p)
    TIMESTAMP_EXTRACTED=$((16#$TS_HEX_EXTRACTED))
    FORMATTED_EMBEDDED_DATE=$(date -d "@$TIMESTAMP_EXTRACTED" "+%Y-%m-%d %H:%M:%S %Z" 2>/dev/null || date -r "$TIMESTAMP_EXTRACTED" "+%Y-%m-%d %H:%M:%S %Z" 2>/dev/null || echo "$TIMESTAMP_EXTRACTED")

    # 4. Key Size (2 Bytes Hex at offset 8)
    KEY_LEN_HEX=$(tail -c +8 "$RESTORED_PAYLOAD" | head -c 2 | xxd -p)
    KEY_LEN_DEC=$((16#$KEY_LEN_HEX))

    # 5. Extract Key Bytes (Key Size Bytes at offset 10)
    TEMP_KEY_FILE=$(mktemp)
    tail -c +10 "$RESTORED_PAYLOAD" | head -c "$KEY_LEN_DEC" > "$TEMP_KEY_FILE"

    # 6. Extract Embedded Checksum (4 Bytes at offset 10 + KEY_LEN)
    CHECKSUM_OFFSET=$((10 + KEY_LEN_DEC))
    EMBEDDED_HASH_HEX=$(tail -c +$CHECKSUM_OFFSET "$RESTORED_PAYLOAD" | head -c 4 | xxd -p)

    # Calculate actual Hash of extracted Key Bytes
    CALCULATED_HASH_HEX=$(openssl dgst -sha256 -binary "$TEMP_KEY_FILE" | head -c 4 | xxd -p)

    echo "[+] Verifying 4-byte SHA-256 Checksum..."
    if [ "$EMBEDDED_HASH_HEX" != "$CALCULATED_HASH_HEX" ]; then
        echo "[-] Error: Key Hash verification failed! Data was corrupted."
        rm -f "$DECRYPTED_RAW" "$CIPHERTEXT_FILE" "$RAW_DATA_TO_MAC" "$RESTORED_PAYLOAD" "$TEMP_KEY_FILE"
        exit 1
    fi

    # Write final verified bytes to file.key
    mv "$TEMP_KEY_FILE" "$OUTPUT_KEY"
    
    echo -e "\n[✔] Key Restored & Validated Successfully!"
    echo "========================================"
    echo "Payload Version  : $VERSION_DEC"
    echo "Creation Date    : $FORMATTED_EMBEDDED_DATE"
    echo "Key Size         : $KEY_LEN_DEC bytes"
    echo "Checksum Match   : OK (0x$CALCULATED_HASH_HEX)"
    echo "Restored File    : $OUTPUT_KEY"
    echo "========================================"

    # Cleanup
    rm -f "$DECRYPTED_RAW" "$CIPHERTEXT_FILE" "$RAW_DATA_TO_MAC" "$RESTORED_PAYLOAD"
}

# ------------------------------------------------------------------
# CLI Entry Point
# ------------------------------------------------------------------
case "$1" in
    generate)
        encrypt_key "$@"
        ;;
    decrypt)
        decrypt_key "$@"
        ;;
    *)
        echo "Usage: $0 {generate [size_in_bytes]|decrypt [file.txt]}"
        exit 1
        ;;
esac